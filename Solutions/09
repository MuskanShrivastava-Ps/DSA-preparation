class Main{
    public static void main(String[] args){
      int n = 8;
      
      int a = 0;
      int b = 1;
      
      if(n==1){
          System.out.println(a);
      }
      else if(n==2){
          System.out.println(b);
      }
      else{
          System.out.println(a);
          System.out.println(b);
      }
      
      int i = 3;
      
      while(i<=n){
           int temp = a + b;
           a = b;
           b = temp;
           System.out.println(b);
           i++;
      }
    }
}
