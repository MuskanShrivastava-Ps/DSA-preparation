import java.util.*;

public class Main{
    public static void main(String[] args){
      int[][] matrix = {{1,2,3},{4,5,6},{7,8,9}};
      int n = matrix.length;

      transpose(matrix,n);
      reverse(matrix,n);

      for(int i = 0; i<n; i++){
        for(int j = 0; j<n; j++){
          System.out.print(matrix[i][j]+" ");
        }
        System.out.println();
      }
    }

    public static void transpose(int[][] matrix, int n){
      
      for(int i = 0; i<n; i++){
        for(int j = 0; j<n; j++){
          if(i!=j && i<j){
            int temp = matrix[i][j];
            matrix[i][j] = matrix[j][i];
            matrix[j][i] = temp;
          }
        }
      }
    }

    public static void reverse(int[][] matrix, int n){

      for(int i = 0; i<n; i++){
        for(int j = 0; j<n/2; j++){
          int l = n-1-j;
          int temp = matrix[i][j];
          matrix[i][j] = matrix[i][l];
          matrix[i][l] = temp;
        }
      }
    }
}
