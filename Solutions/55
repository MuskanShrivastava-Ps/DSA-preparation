class Main {
    public static void main(String[] args){
        int N = 9;
        
        for(int i = 1; i<=N; i++){
            if(gcd(i,N)==1){
                System.out.print(i+" ");
            }
        }
    }
    
     public static int gcd(int num1, int num2){
         int min = num1;
         if(num2<min){
             min = num2;
         }
         
         int ans = 0;
         
         for(int i = min; i>=1; i--){
             if(num1%i==0 && num2%i==0){
                 ans = i;
                 break;
             }
         }
         return ans;
    }
}
