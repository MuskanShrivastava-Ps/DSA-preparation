public class Main{
    public static void main(String[] args){
        int day = 4;
        int month = 7;
        int year = 2023;
        int newmonth = month;
        
       if(month==1){
           newmonth = 13;
           year = year-1;
       }
       else if(month==2){
           newmonth = 14;
           year = year-1;
       }
        
        int q = day;
        int m = newmonth;
        int k = year % 100;
        int j = year / 100;

        int h = (((q+(13*(m+1)/5) + k + (k/4) + (j/4) -2*j) % 7)+7)%7;

        String[] weekdays = {"S","SU","M","T","W","Th","F"};

        System.out.print(weekdays[h]);
        
    }
}
