    public static void main(String[] args){
        int[][] matrix = {{2,3},{3,5},{2,7}};
        int n = matrix.length;
        int[] num1 = matrix[0];
        int val = num1[0];
        int jump = 1;
        
        for(int i = 0; i<n; i++){
            int[] num = matrix[i];
