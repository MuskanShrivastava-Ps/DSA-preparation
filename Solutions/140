public class Main {
    public static void main(String[] args) {
        int[] num = {1,1,0,1,1,1,0,1};
        int count = 0;
        int max = 0;

        for(int i = 0; i<num.length; i++){
             if(num[i]==1){
                 count++;
             }
            else{
                 max = Math.max(max,count);
                 count = 0;
            }
        }

        max = Math.max(max,count);

        System.out.print(max);
    }
}
