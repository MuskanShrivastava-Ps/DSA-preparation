class Main{
    public static void main(String[] args){
      int n = 12;
      
      int ans = 0;
      
      for(int i = 1; i<=n/2; i++){
          if(n%i==0){
              ans+=i;
          }
      }
      
      if(ans==n){
          System.out.println("Perfect No");
      }
      else{
          System.out.println("Not Perfect No");
      }
    }   
}
