class Main {
    public static void main(String[] args) {
        int[] nums = {1,3,2,6,5,10};
        
        for(int i = 0; i<nums.length; i++){
            if(nums[i]%2==0){
                System.out.println("Even");
            }
            else{
                System.out.println("Odd");
            }
        }
    }
}
