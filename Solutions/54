class Main {
    public static void main(String[] args) {
        int[] num = {2,6,8};
        
        int lcm = ((num[0] * num[1]) / gcd(num[0],num[1]));
        
        int i = 2;
        while(i<num.length){
             lcm = ((lcm*num[i])/gcd(lcm,num[i]));
             i++;
        }
        System.out.println(lcm);
    }
    
    public static int gcd(int num1, int num2){
         int min = num1;
         if(num2<min){
             min = num2;
         }
         
         int ans = 0;
         
         for(int i = min; i>=1; i--){
             if(num1%i==0 && num2%i==0){
                 ans = i;
                 break;
             }
         }
         return ans;
    }
}
