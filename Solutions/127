public class Main {
    public static void main(String[] args) {
        int n = 35;

        long a = 0;
        long b = 1;

        if(n==a || n==b){
            System.out.println(n);
        }
        else{
            int i = 2;

            while(i<=n){
                long temp = (long) a + b;
                a = b;
                b = temp;
                i++;
            }
            System.out.print(b);
        }
    }
}



