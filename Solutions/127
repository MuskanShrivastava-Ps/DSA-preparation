public class Main {
    public static void main(String[] args) {
         int n = 35;

        int ans = fibo(n);
        System.out.print(ans);
    }

    public static int fibo(int n){
        if(n==0 || n==1){
            return n;
        }

        if(n<0){
            return 0;
        }

        return fibo(n-1) + fibo(n-2);
    }
}
