public class Main{
    public static void main(String[] args){
        int[] arr = {1,3,5,7,9,11};
        int n = arr.length;
        int target = 7;
        int index = BinarySearch(arr,target,0,n-1);
        System.out.print(index);
    }

    public static int BinarySearch(int[] num, int target, int low, int high){
        if(low>high){
            return -1;
        }

        int mid = low+(high-low)/2;

        if(target==num[mid]){
            return mid;
        }
        int left = -1;
        if(target<num[mid]){
            left = BinarySearch(num,target,low,mid-1);
        }
        int right = -1;
        if(target>num[mid]){
            right = BinarySearch(num,target,mid+1,high);
        }

        if(left==-1 && right==-1){
            return -1;
        }
        return left!=-1 ? left : right;
    }
}
