import java.util.*;
public class Main {
    public static void main(String[] args) {
        int D = 4;

        int start = 1000;
        int end = 9999;

        List<Integer> list = new ArrayList<>();

        for(int i = start; i<=end; i++){
             int num = i;
             int sum = 0;
            while(num>0){
                int rem = num%10;
                sum+=(int)(Math.pow(rem,D));
                num/=10;
            }
            if(sum==i){
                list.add(i);
            }
        }

        System.out.print(list);
    }
}
