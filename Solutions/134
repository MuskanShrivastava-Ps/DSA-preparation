import java.util.*;
public class Main {
    public static void main(String[] args) {
        int n = 10000;
        List<Integer> list = new ArrayList<>();

        for(int i = 1; i<=n; i++){
             int num = i;
             int sum = 0;
            for(int j = 1; j<num; j++){
                if(num%j==0){
                    sum+=j;
                }
            }
            if(sum==num){
                list.add(i);
            }
        }

        System.out.println(list);
    }
}
