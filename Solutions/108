import java.util.*;

public class Main {
    public static void main(String[] args) {

        int n = 16;

        for (int i = 1; i <= n; i++) {
            String binaryString = Integer.toString(i, 2);
            int binary = Integer.parseInt(binaryString, 2);

            String hexaString = Integer.toString(i, 16);
            int hexa = Integer.parseInt(hexaString, 16);

            String decimalString = Integer.toString(i, 10);
            int decimal = Integer.parseInt(decimalString, 10);

            String octalString = Integer.toString(i, 8);
            int octal = Integer.parseInt(octalString, 8);

            System.out.print("Row: "+i+" ");
            System.out.print("Binary: "+binary+" ");
            System.out.print("Octal: "+octal+" ");
            System.out.print("Decimal: "+decimal+" ");
            System.out.println("Hexa: "+hexa+" ");
        }
    }
}
