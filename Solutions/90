import java.util.Arrays;

class Main {
    public static void main(String[] args) {
        int N = 1000;
        
        int num = N;
        int steps = 0;
        
        while(num!=6174){
            String str = String.format("%04d",num);
            char[] ch = str.toCharArray();
            Arrays.sort(ch);
            int num1 = 0;
            int num2 = 0;
            
            for(int i = 0; i<ch.length; i++){
                num1 = num1*10+ch[i]-'0';
            }
            
            for(int j = ch.length-1; j>=0; j--){
                num2 = num2*10+ch[j]-'0';
            }
            
            num = num2 - num1;
            steps++;
        }
        
        System.out.print(steps);
    }
}
