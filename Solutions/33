class Main{
    public static void main(String[] args){
       int M = 4;
       int N = 6;
       
       for(int i = 1; i<=M; i++){
           for(int j = 1; j<=N; j++){
               if(i==1 || i==M || j==1 || j==N){
                   System.out.print("*");
               }
               else{
                   System.out.print(" ");
               }
           }
           System.out.println();
       }
}
}
