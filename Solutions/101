import java.util.*;

public class Main{
  public static void main(String[]args){
    int n = 4;

    for(int i = n; i>=1; i--){

      for(int j = 1; j<=n-i; j++){
        System.out.print(" ");
      }

      for(int s = 1; s<i*2; s++){
        System.out.print("*");
      }

      System.out.println();
    }


    for(int k = 2; k<=n; k++){
       
      for(int m = 1; m<=n-k; m++){
        System.out.print(" ");
      }

      for(int l = 1; l<2*k; l++){
        System.out.print("*");
      }

      System.out.println();
    }
  }
}
