class Main{
    public static void main(String[] args){
      int A = 7;
      int B = 5;
      int product = A * B;
      
      while(B!=0){
          int temp = A % B;
          A = B;
          B = temp;
      }
      
      int gcd = A;
      
      int ans = (product)/gcd;
      
      System.out.println(ans);
    }
}
