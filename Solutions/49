import java.util.List;
import java.util.ArrayList;

class Main {
    public static void main(String[] args) {
        int[] array1 = {1,3,5};
        int[] array2 = {2,4,6};
        
        List<Integer> list = new ArrayList<>();
        
        int n = array1.length;
        int m = array2.length;
        int i = 0;
        int j = 0;
        
        while(i!=n && j!=m){
             if(array1[i]<=array2[j]){
                 list.add(array1[i]);
                 i++;
             }
             else{
                 list.add(array2[j]);
                 j++;
             }
        }
        
        while(i<n){
            list.add(array1[i]);
            i++;
        }
        
        while(j<m){
            list.add(array2[j]);
            j++;
        }
        
        System.out.print(list);
    }
}
