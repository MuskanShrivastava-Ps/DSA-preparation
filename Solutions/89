class Main {
    public static void main(String[] args) {
        int N = 27;
        int num = N;
        int step = 0;
        
        while(num>1){
             if(num%2==0){
                 num = num/2;
             }
             else{
                 num = (num * 3)+1;
             }
             step++;
        }
        
        System.out.println(step);
    }
}
