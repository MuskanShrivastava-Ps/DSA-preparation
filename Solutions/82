class Main {
    public static void main(String[] args) {
        int n = 4;
        
        for(int i = 1; i<=n; i++){
            
            for(int j = 1; j<=n-i; j++){
                System.out.print(" ");
            }
            
            for(int s = 1; s<=i; s++){
                System.out.print(s);
            }
            
            for(int r = i-1; r>=1; r--){
                System.out.print(r);
            }
            System.out.println();
        }
        
    }
}
