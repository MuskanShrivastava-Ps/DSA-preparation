class Main {
    public static void main(String[] args) {
        int n = 5;
        
        System.out.print("Triangular: ");
        for(int i = 1; i<=n; i++){
            int triangular = i*(i+1)/2;
            System.out.print(triangular+" ");
        }
        
        System.out.print("Square: ");
        for(int i = 1; i<=n; i++){
            int square = i*i;
            System.out.print(square+" ");
        }
        
        System.out.print("Pentagonal: ");
        for(int i = 1; i<=n; i++){
            int pentagonal = i*(3*i-1)/2;
            System.out.print(pentagonal+" ");
        }
    }
}
