class Main{
    public static void main(String[] args){
      int A = 10;
      int B = 30;
      
      for(int i = A+1; i<B; i++){
          if(isPrime(i)){
              System.out.print(i+" ");
          }
      }
    }
    
    public static boolean isPrime(int n){
      int squareRoot = (int) Math.sqrt(n);
      boolean isPrime = true;
      
      for(int i = 2; i<=squareRoot; i++){
          if(n%i==0){
              isPrime = false;
              break;
          }
      }
      return isPrime;
    }
}
