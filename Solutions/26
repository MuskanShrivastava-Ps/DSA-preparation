class Main{
    public static void main(String[] args){
      int A = 14;
      int B = 16;
      
      boolean oneElement = false;
      
      for(int i = A+1; i<B; i++){
          if(isPrime(i)){
              oneElement = true;
              System.out.print(i+" ");
          }
      }
      
      if(oneElement==false){
          System.out.println("None");
      }
    }
    
    public static boolean isPrime(int n){
      int squareRoot = (int) Math.sqrt(n);
      boolean isPrime = true;
      
      for(int i = 2; i<=squareRoot; i++){
          if(n%i==0){
              isPrime = false;
              break;
          }
      }
      return isPrime;
    }
}
