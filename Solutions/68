class Main {
    public static void main(String[] args) {
        int n = 13;
        int num = n;
        int count = 0;
        
        while(num>0){
             int result = num&1;
             if(result==1){
                 count++;
             }
             num = num>>1;
        }
        
        System.out.print(count);
    }
}



