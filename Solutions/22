class Main{
    public static void main(String[] args){
        int T = 32;
        int scale = 'F';
         
        if(scale=='C'){
            double F = (T*9/5) + 32;
            double K = T + 273.15;
            System.out.println("F: " + F + " " + "K: " + K);
        }
        else if(scale=='F'){
            double C = ((T-32) * 5)/9;
            double K = C + 273.15;
            System.out.println("C: " + C + " " + "K: " + K);
        }
        else{
            double C = T - 273.15;
            double F = (C*9/5) + 32;
            System.out.println("C: " + C + " " + "F: " + F);
        }
    }
}
