public class Main{
    public static void main(String[] args){
    
    int[][] board = {
    {5, 3, 5, 0, 7, 0, 0, 0, 0},
    {6, 0, 0, 1, 9, 5, 0, 0, 0},
    {0, 9, 8, 0, 0, 0, 0, 6, 0},
    {8, 0, 0, 0, 6, 0, 0, 0, 3},
    {4, 0, 0, 8, 0, 3, 0, 0, 1},
    {7, 0, 0, 0, 2, 0, 0, 0, 6},
    {0, 6, 0, 0, 0, 0, 2, 8, 0},
    {0, 0, 0, 4, 1, 9, 0, 0, 5},
    {0, 0, 0, 0, 8, 0, 0, 7, 9}
    };
    
    boolean flag = true;
    int n = board.length;
    int m = board[0].length;
        
     for(int i = 0; i<n; i++){
         for(int j = 0; j<m; j++){
               int row = 0;
               int col = 0;
               int num = board[i][j];
              if(num==0){
                  continue;
              }
             
              for(int r = 0; r<n; r++){
                    if(board[r][j]==num){
                        row++;
                    }
              }
              if(row>1){
                  flag = false;
                  break;
              }

              for(int c = 0; c<m; c++){
                  if(board[i][c]==num){
                      col++;
                  }
              }
               if(col>1){
                  flag = false;
                  break;
              }

              int newr = (i/3)*3;
              int newc = (j/3)*3;
              
              for(int r2 = newr; r2<newr+3; r2++){
                  boolean isfalse = true;
                  for(int c2 = newc; c2<newc+3; c2++){
                      if(r2!=i && c2!=j && board[r2][c2]==num){
                          isfalse = false;
                           flag = false;
                           break;
                      }
                  }
                  if(isfalse==false){
                      break;
                  }
              }

             if(flag==false){
                 break;
             }
         }
         if(flag==false){
             break;
         }
     }

    if(flag==false){
        System.out.print("Invalid");
    }
    else{
        System.out.print("Valid");
    }
        
    }
}
