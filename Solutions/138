public class Main{
    public static void main(String[] args){
        int[] num = {4,3,7,8,2,1};
        int n = num.length;
        
        for(int i = 0; i<n-1; i++){
             if(i%2==0 && num[i]>num[i+1]){
                 swap(num,i,i+1);
             }
            else if(i%2!=0 && num[i]<num[i+1]){
                swap(num,i,i+1);
            }
        }

        for(int i = 0; i<n; i++){
            System.out.print(num[i]+" ");
        }
    }

    public static void swap(int[] num, int i, int j){
        int temp = num[i];
        num[i] = num[j];
        num[j] = temp;
    }
}
