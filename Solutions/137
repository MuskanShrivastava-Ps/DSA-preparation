import java.util.*;
public class Main{
    public static void main(String[] args){
        int[][] matrix = {{1,2,3},{4,5,6},{7,8,9}};
        int n = matrix.length;
        int sum = 0;
        List<List<Integer>> list2 = new ArrayList<>();
        
        for(int i = 0; i<n; i++){
            for(int j = 0; j<n; j++){
                if(i==j){
                    sum+=matrix[i][j];
                }
                int num = matrix[i][j];
                
                int rMin = Integer.MAX_VALUE;
                for(int r = 0; r<n; r++){
                    rMin = Math.min(rMin,matrix[r][j]);
                }

                int cMax = 0;
                for(int c = 0; c<n; c++){
                     cMax = Math.max(cMax,matrix[i][c]);
                }
                List<Integer> list = new ArrayList<>();
                if(rMin==num && cMax==num){
                    list.add(i);
                    list.add(j);
                    list.add(matrix[i][j]);
                    list2.add(new ArrayList<>(list));
                }
            }
        }

        System.out.print("Sum: "+sum+" "+"List: ");
        for(List<Integer> list3 : list2){
            System.out.print(list3);
        }
        
    }
}
