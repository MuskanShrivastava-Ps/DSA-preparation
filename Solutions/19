public class Main{
    public static void main(String[] args){
        
        int n = 90;
        
        if(n>=90 && n<=100){
            System.out.println("A");
        }
        else if(n>=75 && n<=89){
            System.out.println("B");
        }
        else if(n>=60 && n<=74){
            System.out.println("C");
        }
        else if(n>=50 && n>=59){
            System.out.println("D");
        }
        else{
            System.out.println("F");
        }
    }
}
