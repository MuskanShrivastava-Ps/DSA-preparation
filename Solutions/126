public class Main{
    public static void main(String[] args){
         int n = 3;
         int m = 3;

        int count = find(n,m,0,0);
        System.out.print(count);
    }

    public static int find(int n, int m, int i, int j){
        if(i==n || j==m){
            return 0;
        }
        
        if(i==n-1 && j==m-1){
            return 1;
        }
        
        int right = find(n,m,i,j+1);
        int down = find(n,m,i+1,j);

        return right + down;
    }
}
