class Main {
    public static void main(String[] args) {
        int n = 3;
        
        long sumSqr = (n*(n+1)*(2L * n+1)/6);
        long sumCube = ((long)n*(n+1)/2) * ((long)n*(n+1)/2);
        
        
        long alternative = 1;
        int j = 1;
        
        for(int i = 2; i<=n; i++){
            if(j==1){
                j = -1;
            }
            else{
                j = 1;
            }
            
            alternative+=j*i;
        }
        
        System.out.print("SumSqr: "+sumSqr+" , ");
        System.out.print("SumCube: "+sumCube+" , ");
        System.out.print("Alternavite: "+alternative);
    }
}


