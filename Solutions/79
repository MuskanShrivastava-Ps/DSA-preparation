class Main {
    public static void main(String[] args) {
        int[][] matrix = {{1,2,3},{4,5,6}};
        
        int M = matrix.length;
        int N = matrix[0].length;
        
        if(M==N){
            SquareSwap(matrix);
            System.out.println("Square matrix");
            for(int i = 0; i<M; i++){
                for(int j = 0; j<N; j++){
                    System.out.print(matrix[i][j]+" ");
                }
                System.out.println();
            }
        }
        else{
            int[][] mat = Swap(matrix);
            
            int m = mat.length;
            int n = mat[0].length;
            
            System.out.println("Not square matrix");
            for(int i = 0; i<m; i++){
                for(int j = 0; j<n; j++){
                    System.out.print(mat[i][j]+" ");
                }
                System.out.println();
            }
        }
    }
    
    
    public static void SquareSwap(int[][] matrix){
        int n = matrix.length;
        
        for(int i = 0; i<n; i++){
            for(int j = 0; j<n; j++){
                if(i==j){
                    continue;
                }
                if(i<j){
                    int temp = matrix[i][j];
                    matrix[i][j] = matrix[j][i];
                    matrix[j][i] = temp;
                }
            }
        }
    }
    
    
    public static int[][] Swap(int[][] matrix){
        int n = matrix.length;
        int m = matrix[0].length;
        
        int[][] mat = new int[m][n];
        
        for(int i = 0; i<n; i++){
            for(int j = 0; j<m; j++){
                mat[j][i] = matrix[i][j];
            }
        }
        
        return mat;
    }
}
