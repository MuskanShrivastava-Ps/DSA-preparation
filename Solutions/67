class Main {
    public static void main(String[] args) {
        int n = 10;
        
        String str = Binary(n);
        int num = Decimal(str);
        
        System.out.print("Binary: "+str+" , ");
        System.out.print("Decimal: "+num);
    }
    
    public static String Binary(int n){
        StringBuilder sb = new StringBuilder();
        int num = n;
        while(num>0){
             int rem = num%2;
             num = num/2;
             sb.append(rem);
        }
        sb.reverse();
        String binary = sb.toString();
        return binary;
    }
    
    public static int Decimal(String binary){
        int decimal = 0;
        int power = 0;
        
        for(int i = binary.length()-1; i>=0; i--){
            int n1 = binary.charAt(i) - '0';
            if(n1==1){
                decimal+= Math.pow(2,power);
            }
            power++;
        }
        return decimal;
    }
}
