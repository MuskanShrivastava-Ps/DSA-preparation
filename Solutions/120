import java.util.*;

public class Main{
    public static void main(String[] args){
        int[][] matrix = {{1,2,3},{4,5,6},{7,8,9}};

        int sum  = sum(matrix);
        int[] val = find(matrix);
        System.out.print("Sum: "+sum+" , "+" Saddle Point:  "+"("+val[0]+" , "+val[1]+")"+" = "+matrix[val[0]][val[1]]);
    }

    public static int sum(int[][] matrix){
        int ans = 0;

        for(int i = 0; i<matrix.length; i++){
            ans+=matrix[i][matrix.length-1-i];
            for(int j = 0; j<matrix.length; j++){
                if(i==j){
                    ans+=matrix[i][j];
                }
            }
        }

       if((matrix.length%2)!=0){
           int i = matrix.length/2;
           ans = ans - matrix[i][i];   
       }
         return ans;
    }

    public static int[] find(int[][] matrix){
        int n = matrix.length;
        int[] ans = new int[2];
        
        for(int i = 0; i<n; i++){
            boolean flag = true;
            for(int j = 0; j<n; j++){
                int val = matrix[i][j];
                int colMax = 0;
                for(int c = 0; c<n; c++){
                    colMax = Math.max(colMax,matrix[i][c]);
                }
                int rowMin = Integer.MAX_VALUE;
                for(int r = 0; r<n; r++){
                    rowMin = Math.min(rowMin,matrix[r][j]);
                }
                if(val==colMax && val==rowMin){
                     ans[0] = i;
                     ans[1] = j;
                    flag = false;
                    break;
                }
            }
            if(flag==false){
                break;
            }
        }
        return ans;
    }  
}
