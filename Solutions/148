public class Main {
    public static void main(String[] args) {
        String str = "BBABCBCAB";
        int length = find(str,0,str.length()-1);
        System.out.print(length); 
    }

    public static int find(String str, int i, int j){
        if(i==j){
            return 1;
        }
        if(i>j){
            return 0;
        }
        char ch1 = str.charAt(i);
        char ch2 = str.charAt(j);
        
        if(ch1==ch2){
            return 2 + find(str,i+1,j-1);
        }

        int left = find(str,i+1,j);
        int right = find(str,i,j-1);

        return Math.max(left,right);
    }
}
