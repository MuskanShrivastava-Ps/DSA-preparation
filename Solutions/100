    public static boolean prime(int n){
      int squareRoot = (int) Math.sqrt(n);
      boolean isPrime = true;
      
      for(int i = 2; i<=squareRoot; i++){
          if(n%i==0){
              isPrime = false;
              break;
          }
      }
      
      if(isPrime==true){
          return true;
      }
      else{
          return false;
      }
    }

    public static boolean armstrong(int n){
       int num = n;
       int count = 0;
       int ans = 0;
       
       while(num>0){
            count++;
            num = num/10;
       }
       
       num = n;
       while(num>0){
            int rem = num%10;
            ans = ans + (int) Math.pow(rem,count);
            num/=10;
       }
       
       if(ans==n){
          return true;
       }
       else{
          return false;
       }
    }

    public static boolean palindrome(int n){
       int num = n;
       int reverse = 0;
    
       while(num>0){
           int rem = num%10;
           reverse = reverse * 10 + rem;
           num = num/10;
       }
       
       if(n==reverse){
          return true;
       }
       else{
        return false;
       }
    }

    public static boolean harshed(int n){
       int num = n;
       
       int sum = 0;
       
       while(num>0){
           int rem = num%10;
           sum+=rem;
           num = num/10;
       }
       
       if(n%sum==0){
          return true;
       }
       else{
          return false;
       }
    }

    public static boolean happy(int n){
    int num = n;
    List<Integer> list = new ArrayList<>();

    while(num!=1){
      int sum = 0;
      int val = num;
        while(val>0){
          int rem = val%10;
          sum+=(int)Math.pow(rem,2);
          val = val/10;
        }
        num = sum;
        if(list.contains(num)){
          return false;
        }
        list.add(num);
    }

    return true;
    }


    public static int Euclers(int N){
        
        int ans = 0;
        
        if(prime(N)){
            ans = N-1;
        }
        else{
            List<Integer> list = primeFactors(N);
            ans = N;
            
            for(int i = 0; i<list.size(); i++){
                ans = ans - ans/list.get(i);
            }
        }
        return ans;
    }
    
    public static List<Integer> primeFactors(int n){
        List<Integer> list = new ArrayList<>();
        int num = n;
        
        while(num%2==0){
             if(!list.contains(2)){
                 list.add(2);
             }
             num/=2;
        }
        
        for(int i = 3; i*i<=num; i+=2){
            while(num%i==0){
                if(!list.contains(i)){
                 list.add(i);
                }
                num = num/i;
            }
        }
        
        if(num>1){
            list.add(num);
        }
        
        return list;
    }


    public static int collatz(int N){
        long num = N;
        int step = 0;
        
        while(num>1){
             if(num%2==0){
                 num = num/2;
             }
             else{
                 num = ((long)num * 3)+1;
             }
             step++;
        }
        
        return step;
    }


    public static boolean perfect(int n){
      int ans = 0;
      
      for(int i = 1; i<=n/2; i++){
          if(n%i==0){
              ans+=i;
          }
      }
      
      if(ans==n){
          return true;
      }
      else{
          return false;
      }
    }
