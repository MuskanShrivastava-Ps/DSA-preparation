class Main {
    public static void main(String[] args) {
        int n = 4;
        
        for(int i = 1; i<=n; i++){
            
            for(int s = 1; s<=n-i; s++){
                System.out.print(" ");
            }
            
            for(int j = 0; j<i; j++){
                char ch = (char) ('A' + j);
                System.out.print(ch);
            }
            
            for(int k = i-2; k>=0; k--){
                char ch = (char) ('A'+ k);
                System.out.print(ch);
            }
            
            System.out.println();
        }
    }
}
