class Main{
    public static void main(String[] args){
        int A = 10;
        int op = '/';
        int B = 0;
        
        int ans = 1;
        
        if(op=='/' &&  B==0){
            System.out.println("Error Division by zero");
        }
        else{
            if(op=='+'){
                ans = A + B;
            }
            else if(op=='-'){
                ans = A - B;
            }
            else if(op=='*'){
                ans = A * B;
            }
            else{
                ans = A % B; 
            }
            System.out.println(ans);
        }
    }
}
