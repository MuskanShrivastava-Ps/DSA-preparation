public class Main{
    public static void main(String[] args){
        int[] num = {1,2,3,4};
        int n = num.length;

        int[] ans = new int[n];
        int pref = 1;
        for(int i = 0; i<n; i++){
            pref*=num[i];
            ans[i] = pref;
        }
        
        int suff = 1;
        for(int j = n-1; j>=0; j--){
            int product = 1;
             if(j>0){
                 product*=ans[j-1];
             }
             product*=suff;
             ans[j] = product;
             suff*=num[j];
        }

        for(int i = 0; i<ans.length; i++){
             if(i==0){
                 System.out.print("[");
             }
             System.out.print(ans[i]+" , ");
            if(i==n-1){
                System.out.print("]");
            }
        }
    }
}
