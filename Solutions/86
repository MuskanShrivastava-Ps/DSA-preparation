class Main{
    public static void main(String[] args){
        int n = 4;
        
        for(int i = 1; i<=n; i++){
            
            for(int s = 1; s<=n-i; s++){
                System.out.print(" ");
            }
            
            System.out.print(i);
            
            for(int k = 1; k<2*(i-1); k++){
                System.out.print(" ");
            }
            
            if(i!=1){
                System.out.print(i);
            }
            System.out.println();
        }
        
        for(int i = n-1; i>=1; i--){
            
            for(int s = 1; s<=n-i; s++){
                System.out.print(" ");
            }
            
            System.out.print(i);
            
            for(int j = 1; j<2*(i-1); j++){
                System.out.print(" ");
            }
            
           if(i!=1){
                System.out.print(i);
           }
            
           System.out.println();
            
        }
    }
}
