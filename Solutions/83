class Main{
    public static void main(String[] args){
        int n = 4;
        
        for(int i = 1; i<=n; i++){
            for(int j = 1; j<=i; j++){
                System.out.print("1");
            }
            
            for(int s = 1; s<=(2*n)-2*i; s++){
                System.out.print(" ");
            }
            
            for(int k = 1; k<=i; k++){
                System.out.print("0");
            }
            System.out.println();
        }
        
        
        for(int i = n; i>=1; i--){
            
            for(int j = 1; j<=i; j++){
                System.out.print("1");
            }
            
            for(int s = 1; s<=(2*n)-2*i; s++){
                System.out.print(" ");
            }
            
            for(int k = 1; k<=i; k++){
                System.out.print("0");
            }
            
            System.out.println();
        }
    }
}
