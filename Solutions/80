public class Main{
    public static void main(String[] args){
        int n = 3;

        int[][] matrix = new int[n][n];
        int r = 0;
        int c = 0;
        
        for(int i = 1; i<=n*n; i++){
            if(i==1){
                c = n/2;
                matrix[r][c] = i;
                continue;
            }

            int newr = r-1;
            int newc = c+1;
            
            if(newr<0){
                newr = n-1;
            }
            
            if(newc>n-1){
                newc = 0;
            }

            if(matrix[newr][newc]!=0){
                newr = r+1;
                newc = c;
            }

            matrix[newr][newc] = i;
            r = newr;
            c = newc;
        }

        for(int i = 0; i<n; i++){
            for(int j = 0; j<n; j++){
                System.out.print(matrix[i][j]+" ");
            }
            System.out.println();
        }
    }
}   
