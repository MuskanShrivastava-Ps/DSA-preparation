class Main {
    public static void main(String[] args) {
        int n = 100;

        int sum = 0;

        for(int i = 1; i<n; i++){
            if(n%i==0){
                sum+=i;
            }
        }

        int sum2 = 0;

        for(int j = 1; j<sum; j++){
            if(sum%j==0){
                sum2+=j;
            }
        }

        if(sum2==n){
            System.out.println("Amicable Pair");
        }
        else{
            System.out.println("Not Amicable Pair");
        }
    }
}
