import java.util.*;

public class Main{
    public static void main(String[] args){
      int n = 5;
      
      System.out.println("Consecutive ones");
      System.out.println();

      int count = 1;

      for(int i = 1; i<=n; i++){
        for(int j = 1; j<=i; j++){
          System.out.print(count+" ");
          count++;
        }
        System.out.println();
      }

      System.out.println();
      System.out.println("Even ones");
      System.out.println();

      int even = 1;

      for(int i = 1; i<=n; i++){
        for(int j = 1; j<=i; j++){
          while(!even(even)){
            even++;
          }
          System.out.print(even+" ");
          even++;
        }
        System.out.println();
      }

      System.out.println();
      System.out.println("Prime ones");
      System.out.println();

      int prime = 2;

      for(int i = 1; i<=n; i++){
        for(int j = 1; j<=i; j++){
          while(!prime(prime)){
            prime++;
          }
          System.out.print(prime+" ");
          prime++;
        }
        System.out.println();
      }


    }

    public static boolean even(int n){
      return n%2==0 ? true : false;
    }

    public static boolean prime(int n){
      for(int i = 2; i*i<=n; i++){
        if(n%i==0){
          return false;
        }
      }

      return true;
    }
}

