public class Main {
    public static void main(String[] args) {
        int n = 1234;
        int sum = find(n);
        System.out.print(sum);
    }

    public static int find(int n){
        if(n==0){
            return 0;
        }

        int rem = n%10;

        rem+= find(n/10);

        return rem;
    }
}
